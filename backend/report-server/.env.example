PORT=5000
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Windows example:
# GOOGLE_APPLICATION_CREDENTIALS=C:\\test\\PromptArmor\\backend\\report-server\\service-account.json
GCP_PROJECT_ID=Extention
FIRESTORE_COLLECTION=reports
# Optional alternative to path-based credentials:
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Gemini Flash API key — stays on the server, NEVER sent to the extension
GEMINI_API_KEY=

# Shared secret sent by the extension as x-extension-api-key header.
# Leave empty to run unauthenticated (fine for localhost-only setups).
EXTENSION_API_KEY=
